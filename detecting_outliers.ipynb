    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import duckdb as ddb\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"\\n\",\n",
    "    \"ActualForecast = pd.read_csv('data/ActualForecastData.csv', parse_dates=['date_he'])\\n\",\n",
    "    \"backfill = pd.read_csv('data/backfill_2022_clean.csv', parse_dates=['date_he'])\\n\",\n",
    "    \"\\n\",\n",
    "    \"ActualForecast = (\\n\",\n",
    "    \"    pd.concat([backfill, ActualForecast], ignore_index=True)\\n\",\n",
    "    \"    .drop_duplicates('date_he')      # in case backfill and main overlap at the seam\\n\",\n",
    "    \"    .sort_values('date_he')\\n\",\n",
    "    \"    .reset_index(drop=True)\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"rows:\\\", len(ActualForecast))\\n\",\n",
    "    \"print(\\\"range:\\\", ActualForecast['date_he'].min(), \\\"->\\\", ActualForecast['date_he'].max())\\n\",\n",
    "    \"print(\\\"date_he unique:\\\", ActualForecast['date_he'].is_unique)\\n\",\n",
    "    \"\\n\",\n",
    "    \"gap = ActualForecast['date_he'].diff().max()\\n\",\n",
    "    \"print(\\\"largest gap:\\\", gap)\\n\",\n",
    "    \"print(\\\"gaps over 1h:\\\", (ActualForecast['date_he'].diff() > pd.Timedelta('1h')).sum())\\n\",\n",
    "    \"\\n\",\n",
    "    \"d = ActualForecast['date_he'].diff()\\n\",\n",
    "    \"gaps = ActualForecast.loc[d > pd.Timedelta('1h'), ['date_he']].copy()\\n\",\n",
    "    \"gaps['gap'] = d[d > pd.Timedelta('1h')]\\n\",\n",
    "    \"gaps['prev'] = gaps['date_he'] - gaps['gap']\\n\",\n",
    "    \"print(gaps[['prev', 'date_he', 'gap']].to_string(index=False))\\n\",\n",
    "    \"\\n\",\n",
    "    \"d = ActualForecast['date_he'].diff()\\n\",\n",
    "    \"print((d > pd.Timedelta('1h')).sum(), \\\"gaps > 1h\\\")\\n\",\n",
    "    \"print(d[d > pd.Timedelta('1h')])   # full list, no truncation\\n\",\n",
    "    \"\\n\",\n",
    "    \"bf = ActualForecast[ActualForecast['date_he'] < '2023-01-01']\\n\",\n",
    "    \"print(bf.groupby(bf['date_he'].dt.hour).size().min(), \\\"min obs per hour\\\")\"\n",
    "   ],\n",
    "   \"id\": \"6e17658676767213\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"rows: 34076\\n\",\n",
    "      \"range: 2022-11-01 01:00:00 -> 2026-09-24 00:00:00\\n\",\n",
    "      \"date_he unique: True\\n\",\n",
    "      \"largest gap: 1 days 01:00:00\\n\",\n",
    "      \"gaps over 1h: 7\\n\",\n",
    "      \"               prev             date_he             gap\\n\",\n",
    "      \"2023-03-12 01:00:00 2023-03-12 03:00:00 0 days 02:00:00\\n\",\n",
    "      \"2024-03-10 01:00:00 2024-03-10 03:00:00 0 days 02:00:00\\n\",\n",
    "      \"2025-03-09 01:00:00 2025-03-09 03:00:00 0 days 02:00:00\\n\",\n",
    "      \"2026-03-08 01:00:00 2026-03-08 03:00:00 0 days 02:00:00\\n\",\n",
    "      \"2026-07-06 00:00:00 2026-07-07 01:00:00 1 days 01:00:00\\n\",\n",
    "      \"2026-08-06 00:00:00 2026-08-07 01:00:00 1 days 01:00:00\\n\",\n",
    "      \"2026-09-06 00:00:00 2026-09-07 01:00:00 1 days 01:00:00\\n\",\n",
    "      \"7 gaps > 1h\\n\",\n",
    "      \"3145    0 days 02:00:00\\n\",\n",
    "      \"11880   0 days 02:00:00\\n\",\n",
    "      \"20615   0 days 02:00:00\\n\",\n",
    "      \"29350   0 days 02:00:00\\n\",\n",
    "      \"32228   1 days 01:00:00\\n\",\n",
    "      \"32948   1 days 01:00:00\\n\",\n",
    "      \"33668   1 days 01:00:00\\n\",\n",
    "      \"Name: date_he, dtype: timedelta64[us]\\n\",\n",
    "      \"60 min obs per hour\\n\"\n",
    "     ]\n",
