    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from IPython.display import Markdown, display\\n\",\n",
    "    \"\\n\",\n",
    "    \"q = s.quantile([.25, .75, .9, .95, .99])\\n\",\n",
    "    \"\\n\",\n",
    "    \"para = (\\n\",\n",
    "    \"    f\\\"The bulk of the deviation score is centered near zero (median {s.median():.2f}), \\\"\\n\",\n",
    "    \"    f\\\"but the mean sits at {s.mean():.2f}, showing the pull of the upper tail on the average. \\\"\\n\",\n",
    "    \"    f\\\"The standard deviation is {s.std():.2f}, yet the middle 50% of scores span only about \\\"\\n\",\n",
    "    \"    f\\\"{q[.25]:.2f} to {q[.75]:.2f}, far tighter than what the standard deviation suggests. \\\"\\n\",\n",
    "    \"    f\\\"This reflects that most hours sit close to their hour-of-day baseline; the standard deviation is inflated \\\"\\n\",\n",
    "    \"    f\\\"by a thin set of extreme positive scores rather than describing a typical hour. \\\"\\n\",\n",
    "    \"    f\\\"A skew of {s.skew():.2f} and kurtosis of {s.kurtosis():.2f} confirm a distribution that is \\\"\\n\",\n",
    "    \"    f\\\"heavily right-skewed with a fat tail. The tail's reach is visible in the upper quantiles: \\\"\\n\",\n",
    "    \"    f\\\"the 90th percentile is {q[.9]:.2f}, the 95th jumps to {q[.95]:.2f}, and the 99th to {q[.99]:.2f}. \\\"\\n\",\n",
    "    \"    f\\\"The histogram shows the bulk of the mass falling off by a score of about 4, so a cutoff near 10 \\\"\\n\",\n",
    "    \"    f\\\"(roughly the 95th percentile) is a reasonable choice. It sits clearly beyond the dense core, \\\"\\n\",\n",
    "    \"    f\\\"flagging the hours that genuinely separate from the mass, which is what we want to surface.\\\"\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"display(Markdown(para))\"\n",
    "   ],\n",
    "   \"id\": \"42d55ca1726bbac8\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<IPython.core.display.Markdown object>\"\n",
    "      ],\n",
    "      \"text/markdown\": \"The bulk of the deviation score is centered near zero (median -0.06), but the mean sits at 1.67, showing the pull of the upper tail on the average. The standard deviation is 7.61, yet the middle 50% of scores span only about -0.84 to 1.19, far tighter than what the standard deviation suggests. This reflects that most hours sit close to their hour-of-day baseline; the standard deviation is inflated by a thin set of extreme positive scores rather than describing a typical hour. A skew of 6.95 and kurtosis of 66.71 confirm a distribution that is heavily right-skewed with a fat tail. The tail's reach is visible in the upper quantiles: the 90th percentile is 4.51, the 95th jumps to 10.03, and the 99th to 39.02. The histogram shows the bulk of the mass falling off by a score of about 4, so a cutoff near 10 (roughly the 95th percentile) is a reasonable choice. It sits clearly beyond the dense core, flagging the hours that genuinely separate from the mass, which is what we want to surface.\"\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\",\n",
    "     \"jetTransient\": {\n",
    "      \"display_id\": null\n",
    "     }\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 12\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-17T18:27:15.345664Z\",\n",
    "     \"start_time\": \"2026-10-17T18:27:15.326639Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"p95 = ddb.sql('''\\n\",\n",
    "    \"    with threshold as (\\n\",\n",
    "    \"        select *\\n\",\n",
    "    \"        from price_rolling_median\\n\",\n",
    "    \"        where median_deviation_score > (\\n\",\n",
    "    \"            select quantile_cont(median_deviation_score, 0.95)\\n\",\n",
    "    \"            from price_rolling_median )\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    select\\n\",\n",
    "    \"        year(date_he)                              as year,\\n\",\n",
    "    \"        count(*)                                   as n_extreme,\\n\",\n",
    "    \"        min(actual_price)                          as price_min,\\n\",\n",
    "    \"        quantile_cont(actual_price, 0.25)          as price_q25,\\n\",\n",
    "    \"        quantile_cont(actual_price, 0.50)          as price_q5,\\n\",\n",
    "    \"        quantile_cont(actual_price, 0.75)          as price_q75,\\n\",\n",
    "    \"        max(actual_price)                          as price_max,\\n\",\n",
    "    \"        avg(actual_price)                          as price_mean,\\n\",\n",
    "    \"        stddev_samp(actual_price)                  as price_std\\n\",\n",
    "    \"    from threshold\\n\",\n",
    "    \"    group by year(date_he)\\n\",\n",
    "    \"    order by year\\n\",\n",
    "    \"''').df()\\n\",\n",
    "    \"\\n\",\n",
    "    \"price_cap = ddb.sql('''\\n\",\n",
    "    \"    select\\n\",\n",
    "    \"        year(date_he) as year,\\n\",\n",
    "    \"        count(*) as n_cap_hours,\\n\",\n",
    "    \"        sum(case when median_deviation_score > (\\n\",\n",
    "    \"                select quantile_cont(median_deviation_score, 0.95)\\n\",\n",
    "    \"                from price_rolling_median)\\n\",\n",
    "    \"            then 1 else 0 end)             as n_cap_flagged\\n\",\n",
    "    \"    from price_rolling_median\\n\",\n",
    "    \"    where actual_price >= 999.99\\n\",\n",
    "    \"    group by year(date_he)\\n\",\n",
    "    \"    order by year(date_he)\\n\",\n",
    "    \"''')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(p95.round(2).to_string(index=False))\\n\",\n",
    "    \"print(price_cap)\"\n",
    "   ],\n",
    "   \"id\": \"5f654d63cfcb9b73\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \" year  n_extreme  price_min  price_q25  price_q5  price_q75  price_max  price_mean  price_std\\n\",\n",
    "      \" 2023        703      85.63     285.96    442.73     668.66     999.99      484.66     227.71\\n\",\n",
    "      \" 2024        473      74.18     233.57    395.76     665.87     999.99      465.53     273.51\\n\",\n",
    "      \" 2025        291      77.58     215.06    426.85     733.25     999.99      484.36     292.46\\n\",\n",
    "      \" 2026        164      59.96     188.39    359.75     704.53     999.99      455.17     312.13\\n\",\n",
    "      \"┌───────┬─────────────┬───────────────┐\\n\",\n",
    "      \"│ year  │ n_cap_hours │ n_cap_flagged │\\n\",\n",
    "      \"│ int64 │    int64    │    int128     │\\n\",\n",
    "      \"├───────┼─────────────┼───────────────┤\\n\",\n",
    "      \"│  2023 │          18 │             7 │\\n\",\n",
    "      \"│  2024 │          26 │            26 │\\n\",\n",
    "      \"│  2025 │           5 │             5 │\\n\",\n",
    "      \"│  2026 │           2 │             2 │\\n\",\n",
    "      \"└───────┴─────────────┴───────────────┘\\n\",\n",
    "      \"\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 13\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": [\n",
    "    \"Given that $z_i$ measures price movement relative to the hour's recent baseline, year 2023 reads as more conservative with the lowest standard deviation compared to the subsequent years. The elevated price levels reflects on the rolling median, and with capped priced at `$999.99/MWh`, the $z_i$'s tighten. That is why we only see 7 of the 18 capped priced flagged. The remaining caps occurred when that hour's recent normal was already very high. It is also worth noting the cap itself censors the data. There is no way of knowing if those prices could have gone higher had it not been for the price cap.\\n\",\n",
    "    \"\\n\",\n",
    "    \"As price levels decline in the following years, reaching the cap price is genuinely anomalous event against a lower baseline, and the resulting $z_i$ scores are more correspondingly more extreme as evident in 2024 where all the cap hours were flagged.\"\n",
    "   ],\n",
    "   \"id\": \"19ce705b99b0836a\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-17T18:27:15.724851Z\",\n",
    "     \"start_time\": \"2026-10-17T18:27:15.349830Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"RATE = True   # True = extreme hours / total hours in bucket; False = raw counts\\n\",\n",
    "    \"\\n\",\n",
    "    \"p95 = price_rolling_median['median_deviation_score'].quantile(0.95)\\n\",\n",
    "    \"df = price_rolling_median.copy()\\n\",\n",
    "    \"df = df[df['date_he'].dt.year.between(2023, 2025)]\\n\",\n",
    "    \"df['is_ext'] = df['median_deviation_score'] > p95\\n\",\n",
    "    \"\\n\",\n",
    "    \"df['month'] = df['date_he'].dt.month\\n\",\n",
    "    \"df['dow']   = df['date_he'].dt.dayofweek\\n\",\n",
    "    \"df['he']    = df['date_he'].dt.hour.replace(0, 24)   # hour-ending: 0 -> 24\\n\",\n",
    "    \"\\n\",\n",
    "    \"dims = [\\n\",\n",
    "    \"    ('month', 'Month',       list(range(1, 13)),\\n\",\n",
    "    \"        ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']),\\n\",\n",
    "    \"    ('dow',   'Day of week', list(range(7)), ['Mon','Tue','Wed','Thu','Fri','Sat','Sun']),\\n\",\n",
    "    \"    ('he',    'Hour ending', list(range(1, 25)), None),\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 3, figsize=(18, 5))\\n\",\n",
    "    \"for ax, (col, title, order, labels) in zip(axes, dims):\\n\",\n",
    "    \"    ext   = df.loc[df['is_ext'], col].value_counts().reindex(order, fill_value=0)\\n\",\n",
    "    \"    total = df[col].value_counts().reindex(order, fill_value=0)\\n\",\n",
    "    \"    y = (ext / total * 100) if RATE else ext\\n\",\n",
    "    \"    ax.bar(range(len(order)), y.values, color='red', edgecolor='black', linewidth=0.4)\\n\",\n",
    "    \"    ax.set_xticks(range(len(order)))\\n\",\n",
    "    \"    ax.set_xticklabels(labels if labels else order,\\n\",\n",
    "    \"                       rotation=45 if col == 'he' else 0, fontsize=8)\\n\",\n",
    "    \"    ax.set_title(title)\\n\",\n",
    "    \"    ax.set_ylabel('% of hours that are extreme' if RATE else 'count of extreme hours')\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig.suptitle(f'Extreme deviation scores (> {p95:.1f}, 95th pct) — '\\n\",\n",
    "    \"             f'{\\\"rate\\\" if RATE else \\\"count\\\"} by time bucket (2023 - 2025)', y=1.02)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('img/img_6.png')\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
    "   \"id\": \"e1f3ce6403f4b987\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 1800x500 with 3 Axes>\"\n",
    "      ],\n",
    "      \"image/png\": \"\"\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\",\n",
    "     \"jetTransient\": {\n",
    "      \"display_id\": null\n",
    "     }\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 14\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-17T18:27:15.746560Z\",\n",
    "     \"start_time\": \"2026-10-17T18:27:15.735695Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"p_95_nov = ddb.sql('''\\n\",\n",
    "    \"    with tail as (\\n\",\n",
    "    \"        select date_he, actual_price, median_deviation_score\\n\",\n",
    "    \"        from price_rolling_median\\n\",\n",
    "    \"        where median_deviation_score > (\\n\",\n",
    "    \"            select quantile_cont(median_deviation_score, 0.95)\\n\",\n",
    "    \"            from price_rolling_median )\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    select\\n\",\n",
    "    \"        year(date_he)                  as year,\\n\",\n",
    "    \"        count(*)                       as n_flagged_nov,\\n\",\n",
    "    \"        avg(actual_price)              as price_mean,\\n\",\n",
    "    \"        avg(median_deviation_score)    as score_mean,\\n\",\n",
    "    \"        min(median_deviation_score)    as score_min,\\n\",\n",
    "    \"        max(median_deviation_score)    as score_max\\n\",\n",
    "    \"    from tail\\n\",\n",
    "    \"    where month(date_he) = 11\\n\",\n",
    "    \"    group by year(date_he)\\n\",\n",
    "    \"    order by year\\n\",\n",
    "    \"''').df()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(p_95_nov)\"\n",
    "   ],\n",
