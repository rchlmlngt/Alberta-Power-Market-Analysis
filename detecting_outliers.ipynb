    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"initial_id\",\n",
    "   \"metadata\": {\n",
    "    \"collapsed\": true,\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-17T18:27:14.348526Z\",\n",
    "     \"start_time\": \"2026-10-17T18:27:14.212070Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"price_rolling_median = ddb.sql('''\\n\",\n",
    "    \"    with roll_window as (\\n\",\n",
    "    \"        select\\n\",\n",
    "    \"            date_he,\\n\",\n",
    "    \"            actual_price,\\n\",\n",
    "    \"            quantile_cont(actual_price, 0.5) over (\\n\",\n",
    "    \"                partition by hour(date_he)\\n\",\n",
    "    \"                order by date_he\\n\",\n",
    "    \"                rows between 28 preceding and 1 preceding --rolling window, not including the current value\\n\",\n",
    "    \"                ) as same_hour_28_obs_roll_med\\n\",\n",
    "    \"        from ActualForecast\\n\",\n",
    "    \"    ),\\n\",\n",
    "    \"    roll_MAD as (\\n\",\n",
    "    \"        select\\n\",\n",
    "    \"            *,\\n\",\n",
    "    \"            quantile_cont(abs(actual_price - same_hour_28_obs_roll_med), 0.5) over (\\n\",\n",
    "    \"                partition by hour(date_he)\\n\",\n",
    "    \"                order by date_he\\n\",\n",
    "    \"                rows between 28 preceding and 1 preceding\\n\",\n",
    "    \"            ) as same_hour_28_obs_roll_MAD -- median absolute deviation\\n\",\n",
    "    \"        from roll_window\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    select\\n\",\n",
    "    \"        date_he,\\n\",\n",
    "    \"        actual_price,\\n\",\n",
    "    \"        same_hour_28_obs_roll_med,\\n\",\n",
    "    \"        same_hour_28_obs_roll_MAD,\\n\",\n",
    "    \"        (actual_price - same_hour_28_obs_roll_med) / same_hour_28_obs_roll_MAD as median_deviation_score\\n\",\n",
    "    \"    from roll_MAD\\n\",\n",
    "    \"    where date_he >= '2023-01-01'\\n\",\n",
    "    \"    order by date_he\\n\",\n",
    "    \"    ''').df()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Check that the rolling median is computed correctly\\n\",\n",
    "    \"check_med = ActualForecast[['date_he', 'actual_price']].copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"check_med['roll_med'] = (\\n\",\n",
    "    \"    ActualForecast\\n\",\n",
    "    \"    .groupby(ActualForecast['date_he'].dt.hour)['actual_price']\\n\",\n",
    "    \"    .transform(lambda s: s.shift(1).rolling(28).median()) # preserve original df while adding new column\\n\",\n",
    "    \")\\n\",\n",
    "    \"check_med = check_med[check_med['date_he'] >= '2023-01-01']\\n\",\n",
    "    \"a = price_rolling_median.set_index('date_he')['same_hour_28_obs_roll_med']\\n\",\n",
    "    \"b = check_med.set_index('date_he')['roll_med'].dropna()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 1. Indexes must be unique, or alignment fans out / misbehaves\\n\",\n",
    "    \"print(\\\"a index unique:\\\", a.index.is_unique)\\n\",\n",
    "    \"print(\\\"b index unique:\\\", b.index.is_unique)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 2. How many labels actually overlap? (this is what gets compared)\\n\",\n",
    "    \"print(\\\"overlap:\\\", a.index.intersection(b.index).size)\\n\",\n",
    "    \"print(\\\"a only:\\\", a.index.difference(b.index).size)\\n\",\n",
    "    \"print(\\\"b only:\\\", b.index.difference(a.index).size)\\n\",\n",
    "    \"\\n\",\n",
    "    \"diff = (a - b).abs()\\n\",\n",
    "    \"print(\\\"non-NaN comparisons:\\\", diff.notna().sum())\\n\",\n",
    "    \"print(\\\"max abs diff:\\\", diff.max())\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Check MAD is computed correctly\\n\",\n",
    "    \"check_MAD = ActualForecast[['date_he', 'actual_price']].copy()\\n\",\n",
    "    \"check_MAD['roll_med'] = check_med['roll_med']\\n\",\n",
    "    \"check_MAD['abs_resid'] = (check_MAD['actual_price'] - check_MAD['roll_med']).abs()\\n\",\n",
    "    \"check_MAD['roll_MAD'] = (\\n\",\n",
    "    \"    check_MAD\\n\",\n",
    "    \"    .groupby(ActualForecast['date_he'].dt.hour)['abs_resid']\\n\",\n",
    "    \"    .transform(lambda s: s.shift(1).rolling(28).median())\\n\",\n",
    "    \")\\n\",\n",
    "    \"check_MAD = check_MAD[check_MAD['date_he'] >= '2023-01-01']\\n\",\n",
    "    \"\\n\",\n",
    "    \"c = price_rolling_median.set_index('date_he')['same_hour_28_obs_roll_MAD']\\n\",\n",
    "    \"d = check_MAD.set_index('date_he')['roll_MAD'].dropna()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 1. Indexes must be unique, or alignment fans out / misbehaves\\n\",\n",
    "    \"print(\\\"c index unique:\\\", c.index.is_unique)\\n\",\n",
    "    \"print(\\\"d index unique:\\\", d.index.is_unique)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 2. How many labels actually overlap? (this is what gets compared)\\n\",\n",
    "    \"print(\\\"overlap:\\\", c.index.intersection(d.index).size)\\n\",\n",
    "    \"print(\\\"c only:\\\", c.index.difference(d.index).size)\\n\",\n",
    "    \"print(\\\"d only:\\\", d.index.difference(c.index).size)\\n\",\n",
    "    \"\\n\",\n",
    "    \"diff_mad = (c - d).abs()\\n\",\n",
    "    \"print(\\\"non-NaN comparisons:\\\", diff_mad.notna().sum())\\n\",\n",
    "    \"print(\\\"max abs diff:\\\", diff_mad.max())\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(price_rolling_median.info())\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"start:\\\", price_rolling_median['date_he'].min(), \\\"| end:\\\", price_rolling_median['date_he'].max())\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"a index unique: True\\n\",\n",
    "      \"b index unique: True\\n\",\n",
    "      \"overlap: 32613\\n\",\n",
    "      \"a only: 0\\n\",\n",
    "      \"b only: 0\\n\",\n",
    "      \"non-NaN comparisons: 32613\\n\",\n",
    "      \"max abs diff: 0.0\\n\",\n",
    "      \"c index unique: True\\n\",\n",
    "      \"d index unique: True\\n\",\n",
    "      \"overlap: 31941\\n\",\n",
    "      \"c only: 672\\n\",\n",
    "      \"d only: 0\\n\",\n",
    "      \"non-NaN comparisons: 31941\\n\",\n",
    "      \"max abs diff: 0.0\\n\",\n",
    "      \"<class 'pandas.DataFrame'>\\n\",\n",
    "      \"RangeIndex: 32613 entries, 0 to 32612\\n\",\n",
    "      \"Data columns (total 5 columns):\\n\",\n",
    "      \" #   Column                     Non-Null Count  Dtype         \\n\",\n",
    "      \"---  ------                     --------------  -----         \\n\",\n",
    "      \" 0   date_he                    32613 non-null  datetime64[us]\\n\",\n",
    "      \" 1   actual_price               32613 non-null  float64       \\n\",\n",
    "      \" 2   same_hour_28_obs_roll_med  32613 non-null  float64       \\n\",\n",
    "      \" 3   same_hour_28_obs_roll_MAD  32613 non-null  float64       \\n\",\n",
    "      \" 4   median_deviation_score     32613 non-null  float64       \\n\",\n",
    "      \"dtypes: datetime64[us](1), float64(4)\\n\",\n",
    "      \"memory usage: 1.2 MB\\n\",\n",
    "      \"None\\n\",\n",
    "      \"start: 2023-01-01 00:00:00 | end: 2026-09-24 00:00:00\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 10\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-17T18:27:15.305858Z\",\n",
    "     \"start_time\": \"2026-10-17T18:27:14.358058Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"s = price_rolling_median['median_deviation_score'].dropna()\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(1, 2, figsize=(14, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Left: the bulk — zoom to where normal hours live, linear y\\n\",\n",
    "    \"ax[0].hist(s, bins=200, range=(-5, 10), color='steelblue', edgecolor='none')\\n\",\n",
    "    \"ax[0].axvline(0, color='white', lw=0.8, ls='--')   # no-deviation line\\n\",\n",
    "    \"ax[0].set_title('Deviation score — bulk (-5 to 10)')\\n\",\n",
    "    \"ax[0].set_xlabel('median deviation score')\\n\",\n",
    "    \"ax[0].set_ylabel('count')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Right: full range, log y — so the spike tail is visible\\n\",\n",
    "    \"ax[1].hist(s, bins=300, color='red', edgecolor='none')\\n\",\n",
    "    \"ax[1].set_yscale('log')\\n\",\n",
    "    \"ax[1].axvline(0, color='white', lw=0.8, ls='--')\\n\",\n",
    "    \"ax[1].set_title('Deviation score — full range, log count')\\n\",\n",
    "    \"ax[1].set_xlabel('median deviation score')\\n\",\n",
    "    \"ax[1].set_ylabel('count (log)')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(15, 6))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# scatter of every hour's score (labeled so the legend has something to show)\\n\",\n",
    "    \"ax.scatter(price_rolling_median['date_he'], price_rolling_median['median_deviation_score'],\\n\",\n",
    "    \"           s=2, alpha=0.4, color='steelblue', label='hourly score')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# set x-limits BEFORE reading them for label placement\\n\",\n",
    "    \"ax.margins(x=0)\\n\",\n",
    "    \"x_right = ax.get_xlim()[1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# percentile ladder\\n\",\n",
    "    \"qs = [.5, .9, .95, .96, .975, .99, .999]\\n\",\n",
    "    \"qvals = price_rolling_median['median_deviation_score'].quantile(qs)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# plot the z_i's\\n\",\n",
    "    \"colors = plt.cm.autumn(np.linspace(0, 0.8, len(qs)))\\n\",\n",
    "    \"for (q, v), c in zip(qvals.items(), colors):\\n\",\n",
    "    \"    ax.axhline(v, color=c, lw=0.8, ls='--', label=f'P{q*100:g} = {v:.1f}')\\n\",\n",
    "    \"    ax.text(x_right, v, f'  P{q*100:g} = {v:.1f}',\\n\",\n",
    "    \"            va='center', ha='left', fontsize=7, color=c)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.axhline(0, color='gray', lw=0.5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.set_title('Per-hour deviation score over time')\\n\",\n",
    "    \"ax.set_xlabel('date')\\n\",\n",
    "    \"ax.set_ylabel('median deviation score (z_is)')\\n\",\n",
    "    \"ax.legend(loc='upper left', fontsize=7, framealpha=0.3)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# he 18 plot\\n\",\n",
    "    \"\\n\",\n",
    "    \"he = 18\\n\",\n",
    "    \"sub = price_rolling_median[price_rolling_median['date_he'].dt.hour == he].copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"p95 = price_rolling_median['median_deviation_score'].quantile(0.95)\\n\",\n",
    "    \"flagged = sub[sub['median_deviation_score'] > p95]\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(2, 1, figsize=(15, 7), sharex=True,\\n\",\n",
    "    \"                       gridspec_kw={'height_ratios': [3, 1]})\\n\",\n",
    "    \"\\n\",\n",
    "    \"# top: price, median, flagged\\n\",\n",
    "    \"ax[0].plot(sub['date_he'], sub['actual_price'],\\n\",\n",
    "    \"           color='steelblue', lw=0.5, alpha=0.7, label='actual price')\\n\",\n",
    "    \"ax[0].plot(sub['date_he'], sub['same_hour_28_obs_roll_med'],\\n\",\n",
    "    \"           color='red', lw=1.0, label='rolling median (28 same-hour obs)')\\n\",\n",
    "    \"ax[0].scatter(flagged['date_he'], flagged['actual_price'],\\n\",\n",
    "    \"              color='gold', s=20, zorder=5, label='flagged (> P95)')\\n\",\n",
    "    \"ax[0].set_ylabel('price ($/MWh)')\\n\",\n",
    "    \"ax[0].set_title(f'Actual price vs rolling median — hour ending {he}')\\n\",\n",
    "    \"ax[0].legend(loc='upper right')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# bottom: deviation score, with the P95 cutoff drawn in\\n\",\n",
    "    \"ax[1].plot(sub['date_he'], sub['median_deviation_score'],\\n\",\n",
    "    \"           color='steelblue', lw=0.6, alpha=0.8, label='deviation score')\\n\",\n",
    "    \"ax[1].axhline(p95, color='gold', lw=1.0, ls='--', label=f'P95 = {p95:.1f}')\\n\",\n",
    "    \"ax[1].axhline(0, color='gray', lw=0.5)\\n\",\n",
    "    \"ax[1].set_ylabel('score')\\n\",\n",
