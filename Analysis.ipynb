    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"f7e315ddc47b8db5\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"#### Average demand by hour throughout the week\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"b1eb3645dbf0e4f\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-17T18:26:31.824392Z\",\n",
    "     \"start_time\": \"2026-10-17T18:26:31.438767Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"day_map = {\\n\",\n",
    "    \"    0: 'Sunday',\\n\",\n",
    "    \"    1: 'Monday',\\n\",\n",
    "    \"    2: 'Tuesday',\\n\",\n",
    "    \"    3: 'Wednesday',\\n\",\n",
    "    \"    4: 'Thursday',\\n\",\n",
    "    \"    5: 'Friday',\\n\",\n",
    "    \"    6: 'Saturday'\\n\",\n",
    "    \"}\\n\",\n",
    "    \"hourly_demand = ddb.sql('''\\n\",\n",
    "    \"    select\\n\",\n",
    "    \"        case when hour(date_he) = 0 then 24\\n\",\n",
    "    \"            else hour(date_he)\\n\",\n",
    "    \"            end as hour,\\n\",\n",
    "    \"        dayofweek(date_he) as day_of_week,\\n\",\n",
    "    \"        avg(actual_ail) as avg_ail\\n\",\n",
    "    \"    from ActualForecast\\n\",\n",
    "    \"    group by hour, day_of_week\\n\",\n",
    "    \"    order by hour, day_of_week\\n\",\n",
    "    \"''').df()\\n\",\n",
    "    \"hourly_demand = hourly_demand.pivot(index='hour', columns='day_of_week', values='avg_ail')\\n\",\n",
    "    \"hourly_demand = hourly_demand.rename(columns=day_map)\\n\",\n",
    "    \"hourly_demand = hourly_demand[['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday']]\\n\",\n",
    "    \"\\n\",\n",
    "    \"#################### PLOT ##############################\\n\",\n",
    "    \"hourly_demand.plot(figsize=(12, 6), marker='o')\\n\",\n",
    "    \"plt.xlim(1, 24)\\n\",\n",
    "    \"plt.xticks(range(1, 25))\\n\",\n",
    "    \"plt.title('Average Hourly Demand by Day of the Week')\\n\",\n",
    "    \"plt.ylabel('Average Actual AIL MW')\\n\",\n",
    "    \"plt.xlabel('Hour Ending')\\n\",\n",
    "    \"plt.grid(True)\\n\",\n",
    "    \"plt.legend(loc = 'upper left')\\n\",\n",
    "    \"plt.savefig('img/img.png')\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 1200x600 with 1 Axes>\"\n",
    "      ],\n",
    "      \"image/png\": \"\"\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\",\n",
    "     \"jetTransient\": {\n",
    "      \"display_id\": null\n",
    "     }\n",
    "    }\n",
    "   ],\n",
