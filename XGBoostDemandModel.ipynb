    "   \"id\": \"d44fabecfac534cb\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Create Model Features\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"21fa8953ba5713c0\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-16T20:26:24.865307Z\",\n",
    "     \"start_time\": \"2026-10-16T20:26:24.859018Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"def create_features(data):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Build time and lag features for hourly AIL.\\n\",\n",
    "    \"    :param data: DataFrame with 'date_he' and 'actual_ail', sorted by time.\\n\",\n",
    "    \"                 Call on the FULL series, then slice, so lags line up correctly.\\n\",\n",
    "    \"    :return: X (features), Y (target), keeping the original index\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    data = data.copy()  # avoid modifying original DataFrame\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Time features\\n\",\n",
    "    \"    data['Hour'] = data['date_he'].dt.hour\\n\",\n",
    "    \"    data['Day'] = data['date_he'].dt.dayofweek\\n\",\n",
    "    \"    data['Month'] = data['date_he'].dt.month\\n\",\n",
    "    \"    data['is_weekend'] = (data['Day'] >= 5).astype(int)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Lag features (autoregression)\\n\",\n",
    "    \"    data['lag1'] = data['actual_ail'].shift(1)      # 1 hour ago\\n\",\n",
    "    \"    data['lag24'] = data['actual_ail'].shift(24)    # same hour yesterday\\n\",\n",
    "    \"    data['lag168'] = data['actual_ail'].shift(168)  # same hour last week\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Drop rows whose lags reach across a missing-data gap.\\n\",\n",
    "    \"    # shift() counts rows, not hours, so for 168 rows after a gap the lags\\n\",\n",
    "    \"    # point at the wrong hours. 2-hour jumps are spring DST and are kept.\\n\",\n",
    "    \"    gap = data['date_he'].diff() > pd.Timedelta(hours=2)\\n\",\n",
    "    \"    crosses_gap = gap.astype(int).rolling(168, min_periods=1).max().astype(bool)\\n\",\n",
    "    \"    data = data[~crosses_gap]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    data = data.dropna()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    feature_cols = ['Hour', 'Day', 'Month', 'is_weekend',\\n\",\n",
    "    \"                    'lag1', 'lag24', 'lag168']\\n\",\n",
    "    \"    X = data[feature_cols]\\n\",\n",
    "    \"    Y = data['actual_ail']\\n\",\n",
    "    \"    return X, Y\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 23\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"158530f1b8d3c6c7\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Walk Forward Validation\\n\",\n",
    "    \"\\n\",\n",
    "    \"Walk-forward validation iteratively trains and tests a model on a consistent window size across consecutive periods. Think of it like a sliding window — at each step the model is retrained on the most recent historical window and tested on the next unseen period, ensuring the model only learns from the past. This allows the model to capture evolving patterns and detect structural drifts in the data over time.\\n\",\n",
    "    \"\\n\",\n",
    "    \"#### Walk Forward Validation: Deriving Window Size\\n\",\n",
    "    \"##### Problem\\n\",\n",
    "    \"\\n\",\n",
    "    \"Given a dataset of length `len(DF)`, a desired number of folds `n_folds`, and a training spilt ratio `r`, find:\\n\",\n",
    "    \"- `x` — the step size\\n\",\n",
    "    \"- `y` — the fold length (training window + test window)\\n\",\n",
    "    \"\\n\",\n",
    "    \"---\\n\",\n",
    "    \"\\n\",\n",
    "    \"#### Two Equations, Two Unknowns\\n\",\n",
    "    \"\\n\",\n",
    "    \"##### Equation 1 — Rolling Window Formula\\n\",\n",
    "    \"\\n\",\n",
    "    \"Each fold advances by one step `x`, and the first fold requires a full fold length `y`:\\n\",\n",
    "    \"\\n\",\n",
    "    \"$$\\\\text{len(DF)} = y + ( \\\\text{nfolds} - 1) \\\\cdot x$$\\n\",\n",
    "    \"\\n\",\n",
    "    \"##### Equation 2 — Train/Test Ratio\\n\",\n",
    "    \"\\n\",\n",
    "    \"Given a training ratio `r`, the fold length `y` is related to the step `x` by:\\n\",\n",
    "    \"\\n\",\n",
    "    \"$$y = \\\\frac{x}{1 - r}$$\\n\",\n",
    "    \"\\n\",\n",
    "    \"---\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"813f03617a3f6ce4\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-17T02:02:37.412440Z\",\n",
    "     \"start_time\": \"2026-10-17T02:02:37.405294Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"def rolling_backtest(DataFrame, n_folds, train_window_ratio, feature_function):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    This function applies a walk forward validation to assess model performance.\\n\",\n",
    "    \"    :param: Dataframe, with time\\n\",\n",
    "    \"    :param: n_folds, number of folds\\n\",\n",
    "    \"    :param: train_window_ratio,\\n\",\n",
    "    \"    :param: feature_function,\\n\",\n",
    "    \"    :return: Mean_squared_error, RMSE,  Actual_AIL, Predicted_AIL\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    dates = []\\n\",\n",
    "    \"    actual_AIL = []\\n\",\n",
    "    \"    predicted_AIL = []\\n\",\n",
    "    \"    importances = []\\n\",\n",
    "    \"    test_importances = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Build features ONCE on the full series. Each test fold can then use lags\\n\",\n",
    "    \"    # that reach back into the training period, and the gap filter sees every gap.\\n\",\n",
    "    \"    X, Y = feature_function(DataFrame)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    total = len(DataFrame)\\n\",\n",
    "    \"    fold_length = int(total/(1 + (n_folds - 1)*(1-train_window_ratio)))\\n\",\n",
    "    \"    step_size = int(fold_length*(1 - train_window_ratio))\\n\",\n",
    "    \"    training_window = fold_length - step_size\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # range(start, stop, step)\\n\",\n",
    "    \"    for i in range(\\n\",\n",
    "    \"        0, total - fold_length, step_size\\n\",\n",
    "    \"    ):\\n\",\n",
    "    \"        # Split data into training and testing sets\\n\",\n",
    "    \"        train_dataset = (X.index >= i) & (X.index < i + training_window)\\n\",\n",
    "    \"        test_dataset = (X.index >= i + training_window) & (X.index < i + training_window + step_size)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        model = xgb.XGBRegressor(\\n\",\n",
    "    \"            n_estimators=500,   # Number of trees to build\\n\",\n",
    "    \"            learning_rate=0.05, # How much each tree contributes\\n\",\n",
    "    \"            max_depth=3,        # How many levels of questions\\n\",\n",
    "    \"            random_state=42\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        model.fit(X[train_dataset], Y[train_dataset])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Gain: what the model relied on while learning (training data)\\n\",\n",
    "    \"        importances.append(model.get_booster().get_score(importance_type='gain'))\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Permutation: how much RMSE rises on unseen test data when a feature is shuffled   # NEW\\n\",\n",
    "    \"        perm = permutation_importance(\\n\",\n",
    "    \"            model, X[test_dataset], Y[test_dataset],\\n\",\n",
    "    \"            scoring='neg_root_mean_squared_error', n_repeats=5, random_state=42,\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        test_importances.append(pd.Series(perm.importances_mean, index=X.columns))\\n\",\n",
    "    \"\\n\",\n",
    "    \"        dates.extend(DataFrame.loc[X.index[test_dataset], 'date_he'])\\n\",\n",
    "    \"        actual_AIL.extend(Y[test_dataset])\\n\",\n",
    "    \"        predicted_AIL.extend(model.predict(X[test_dataset]))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    mse = mean_squared_error(actual_AIL, predicted_AIL)\\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        'mse'           : mse,\\n\",\n",
    "    \"        'rmse'          : mse**0.5,\\n\",\n",
    "    \"        'dates'         : dates,\\n\",\n",
    "    \"        'actual_AIL'    : actual_AIL,\\n\",\n",
    "    \"        'predicted_AIL' : predicted_AIL,\\n\",\n",
    "    \"        'importances'   : pd.DataFrame(importances).fillna(0),   # one row per fold\\n\",\n",
    "    \"        'test_importances' : pd.DataFrame(test_importances)      # MW of extra RMSE, one row per fold\\n\",\n",
    "    \"    }\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 43\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"99a0cd6815f28dd5\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Plot Results and Residual Analysis\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"95fb556dd3beb39\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-17T04:59:50.831556Z\",\n",
    "     \"start_time\": \"2026-10-17T04:59:48.681648Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Run the Walk Forward Validation Process\\n\",\n",
    "    \"results = rolling_backtest(\\n\",\n",
    "    \"    AIL,\\n\",\n",
    "    \"    n_folds=3,\\n\",\n",
    "    \"    train_window_ratio=0.8,\\n\",\n",
    "    \"    feature_function=create_features\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"Dates = pd.to_datetime(results['dates'])\\n\",\n",
    "    \"Actual_AIL = np.array(results['actual_AIL'])\\n\",\n",
    "    \"Predicted_AIL = np.array(results['predicted_AIL'])\\n\",\n",
    "    \"Residuals = Actual_AIL - Predicted_AIL\\n\",\n",
    "    \"\\n\",\n",
    "    \"######################## Plot results #########################################\\n\",\n",
    "    \"plt.figure(figsize=(18, 5))\\n\",\n",
    "    \"plt.plot(Actual_AIL,    lw=0.6, alpha=0.8, color='steelblue', label='Actual')\\n\",\n",
    "    \"plt.plot(Predicted_AIL, lw=0.6, alpha=0.8, color='red',       label='Predicted')\\n\",\n",
    "    \"plt.title(f'Actual vs Predicted AIL  |  RMSE: {results[\\\"rmse\\\"]:,.0f} MW')\\n\",\n",
    "    \"plt.xlabel('Hour')\\n\",\n",
    "    \"plt.ylabel('AIL (MW)')\\n\",\n",
    "    \"plt.legend()\\n\",\n",
    "    \"plt.grid(True, alpha=0.3)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('img/img_7.png')\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"####################### Residual Analysis #######################################\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 3, figsize=(16, 4))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 1. Residuals over time — look for patterns/drift\\n\",\n",
    "    \"axes[0].plot(Residuals, lw=0.5, alpha=0.7, color='steelblue')\\n\",\n",
    "    \"axes[0].axhline(0, color='red', ls='--', lw=1)\\n\",\n",
    "    \"axes[0].set_title('Residuals over time')\\n\",\n",
    "    \"axes[0].set_ylabel('Residual (MW)')\\n\",\n",
    "    \"axes[0].grid(True, alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 2. Predicted vs Actual — perfect model = straight diagonal line\\n\",\n",
    "    \"axes[1].scatter(Actual_AIL, Predicted_AIL, alpha=0.1, s=1, color='steelblue')\\n\",\n",
    "    \"axes[1].plot([Actual_AIL.min(), Actual_AIL.max()], [Actual_AIL.min(), Actual_AIL.max()], 'r--', lw=1, label='Perfect fit')\\n\",\n",
    "    \"axes[1].set_xlabel('Actual AIL (MW)')\\n\",\n",
    "    \"axes[1].set_ylabel('Predicted AIL (MW)')\\n\",\n",
    "    \"axes[1].set_title('Predicted vs actual')\\n\",\n",
    "    \"axes[1].legend(fontsize=8)\\n\",\n",
    "    \"axes[1].grid(True, alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 3. Residual distribution — should be centered at 0\\n\",\n",
    "    \"axes[2].hist(Residuals, bins=50, color='steelblue', alpha=0.8, edgecolor='white')\\n\",\n",
    "    \"axes[2].axvline(0, color='red', ls='--', label='Zero')\\n\",\n",
    "    \"axes[2].axvline(Residuals.mean(), color='orange', ls='--', label=f'Mean: {Residuals.mean():.0f} MW')\\n\",\n",
    "    \"axes[2].set_xlabel('Residual (MW)')\\n\",\n",
    "    \"axes[2].set_title('Residual distribution')\\n\",\n",
    "    \"axes[2].legend(fontsize=8)\\n\",\n",
    "    \"axes[2].grid(True, alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.suptitle(f'Residual analysis  |  RMSE: {results[\\\"rmse\\\"]:,.0f} MW', fontsize=13)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('img/img_8.png')\\n\",\n",
    "    \"plt.show()\\n\"\n",
    "   ],\n",
