    "      \" 0   date_he         34076 non-null  datetime64[us]\\n\",\n",
    "      \" 1   forecast_price  34076 non-null  float64       \\n\",\n",
    "      \" 2   actual_price    34076 non-null  float64       \\n\",\n",
    "      \" 3   forecast_ail    34076 non-null  int64         \\n\",\n",
    "      \" 4   actual_ail      34076 non-null  int64         \\n\",\n",
    "      \" 5   ail_diff        34076 non-null  int64         \\n\",\n",
    "      \"dtypes: datetime64[us](1), float64(2), int64(3)\\n\",\n",
    "      \"memory usage: 1.6 MB\\n\",\n",
    "      \"None\\n\"\n",
